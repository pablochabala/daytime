# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase: Project Settings -> API (or "Data API").
# When both are set, the site stores accounts, listings and photos in Supabase.
# When they're empty, it falls back to the local web/.data folder.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "service_role" (secret) key. It bypasses Row Level Security, so keep it server-side only:
# never put it in NEXT_PUBLIC_ variables, client code or GitHub.
SUPABASE_SERVICE_ROLE_KEY=

# Photo bucket created by supabase/schema.sql
SUPABASE_PHOTO_BUCKET=listing-photos

# Signs login cookies. Required with Supabase. Any long random string, e.g. run:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
